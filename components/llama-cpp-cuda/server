#!/bin/bash -eux

export PATH="$SNAP_COMPONENTS/llama-cpp-cuda/bin:$SNAP_COMPONENTS/llama-cpp-cuda/usr/bin:$SNAP_COMPONENTS/llama-cpp-cuda/usr/local/bin:$PATH"
export LD_LIBRARY_PATH="$SNAP_COMPONENTS/llama-cpp-cuda/lib:$SNAP_COMPONENTS/llama-cpp-cuda/usr/local/lib:$SNAP_COMPONENTS/llama-cpp-cuda/usr/local/bin:$SNAP_COMPONENTS/llama-cpp-cuda/usr/lib/aarch64-linux-gnu/nvidia:$SNAP_COMPONENTS/llama-cpp-cuda/usr/lib/aarch64-linux-gnu/tegra:$SNAP_COMPONENTS/llama-cpp-cuda/usr/lib/aarch64-linux-gnu:$SNAP_COMPONENTS/llama-cpp-cuda/usr/local/cuda-12.6/lib64:$SNAP_COMPONENTS/llama-cpp-cuda/usr/local/cuda-12.6/targets/aarch64-linux/lib:$SNAP_COMPONENTS/llama-cpp-cuda/usr/local/cuda/lib64:${LD_LIBRARY_PATH:-}"
export MODEL_FILE="${MODEL_FILE:-$SNAP_COMPONENTS/model-qwen35-4b-ud-q4-k-xl/Qwen3.5-4B-UD-Q4_K_XL.gguf}"
export MMPROJ_FILE="${MMPROJ_FILE:-$SNAP_COMPONENTS/model-qwen35-4b-mmproj-bf16/mmproj-BF16.gguf}"

cache_model_file() {
  local source_file="$1"
  local target_file="$2"
  local target_dir

  target_dir="$(dirname "$target_file")"
  mkdir -p "$target_dir"

  if [ -f "$target_file" ] && [ "$(stat -c %s "$source_file")" = "$(stat -c %s "$target_file")" ]; then
    echo "Using cached model file: $target_file"
    return
  fi

  echo "Caching model file from $source_file to $target_file"
  cp "$source_file" "$target_file.tmp"
  mv "$target_file.tmp" "$target_file"
}

cached_model_file="$SNAP_COMMON/models/qwen35-4b/Qwen3.5-4B-UD-Q4_K_XL.gguf"
cached_mmproj_file="$SNAP_COMMON/models/qwen35-4b/mmproj-BF16.gguf"
cache_model_file "$MODEL_FILE" "$cached_model_file"
cache_model_file "$MMPROJ_FILE" "$cached_mmproj_file"
MODEL_FILE="$cached_model_file"
MMPROJ_FILE="$cached_mmproj_file"

port="$(modelctl get http.port)"

exec llama-server \
  --model "$MODEL_FILE" \
  --mmproj "$MMPROJ_FILE" \
  --host 0.0.0.0 \
  --port "$port" \
  --ctx-size 4096 \
  --parallel 1 \
  --batch-size 512 \
  --ubatch-size 128 \
  --cache-type-k q8_0 \
  --cache-type-v q8_0 \
  --flash-attn auto \
  --n-gpu-layers auto \
  --reasoning-budget 64 \
  "$@"
