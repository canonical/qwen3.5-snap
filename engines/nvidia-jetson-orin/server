#!/bin/bash -eu

port="$(modelctl get http.port)"
host="$(modelctl get http.host)"
sleep_idle_seconds="$(modelctl get sleep-idle-seconds)"

extra_args=()

verbose="$(modelctl get verbose)"
if [ "${verbose}" = "true" ]; then
  extra_args+=(--verbose)
fi

mmproj_args=()
if [ -n "${MMPROJ_FILE:-}" ]; then
  mmproj_args=(--mmproj "$MMPROJ_FILE")
fi

set -x
# Flags tuned for the memory-constrained Jetson Orin (integrated Tegra GPU).
exec llama-server \
  --model "$MODEL_FILE" \
  --alias "$MODEL_NAME" \
  "${mmproj_args[@]}" \
  --host "$host" \
  --port "$port" \
  --no-warmup \
  --sleep-idle-seconds "$sleep_idle_seconds" \
  --ctx-size 4096 \
  --parallel 1 \
  --batch-size 512 \
  --ubatch-size 128 \
  --cache-type-k q8_0 \
  --cache-type-v q8_0 \
  --flash-attn auto \
  --n-gpu-layers auto \
  --reasoning-budget 64 \
  "${extra_args[@]}" \
  "$@"
